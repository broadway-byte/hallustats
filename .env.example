# Anthropic (Claude) — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (gpt-image-2) — https://platform.openai.com
OPENAI_API_KEY=sk-...

# Notion — create an integration at https://www.notion.so/my-integrations
NOTION_API_KEY=secret_...
NOTION_DATABASE_ID=...

# X / Twitter — OAuth 1.0a (for posting)
TWITTER_API_KEY=...
TWITTER_API_SECRET=...
TWITTER_ACCESS_TOKEN=...
TWITTER_ACCESS_TOKEN_SECRET=...

# X / Twitter — OAuth 2.0 (for v2 media upload; add media.write scope)
# Leave blank to fall back to v1.1 media upload
TWITTER_OAUTH2_TOKEN=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# GitHub repo for card image hosting (e.g. "username/hallustats")
# Cards are committed to cards/ and served via raw.githubusercontent.com
GITHUB_REPO=
GITHUB_BRANCH=main

# Model overrides (defaults work; update if newer models are available)
CLAUDE_DRAFT_MODEL=claude-sonnet-4-6
CLAUDE_CRITIC_MODEL=claude-opus-4-8
